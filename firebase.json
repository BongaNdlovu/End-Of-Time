{
  "functions": [
    {
      "source": "functions"
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      ".git/**",
      "node_modules/**",
      "functions/**",
      "**/*.md",
      "**/*-debug.html",
      "**/*-test.html",
      "**/*.backup",
      "**/*.bak",
      "backups/**",
      "temp-playwright/**",
      "src/**",
      "scripts/**",
      ".cursor/**",
      "*.plan.md"
    ],
    "site": "end-of-time-94cd3",
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://apis.google.com https://www.google.com https://www.recaptcha.net https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://www.paperturn.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://*.googleapis.com https://firebase.googleapis.com https://securetoken.googleapis.com https://identitytoolkit.googleapis.com https://apis.google.com https://www.gstatic.com https://*.gstatic.com https://www.google.com https://www.recaptcha.net https://us-central1-end-of-time-94cd3.cloudfunctions.net https://*.cloudfunctions.net; frame-src 'self' https://accounts.google.com https://*.google.com https://www.google.com/recaptcha/ https://www.recaptcha.net/recaptcha/ https://*.gstatic.com https://*.firebaseapp.com https://*.web.app https://*.paperturn-view.com https://heyzine.com https://*.heyzine.com;"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "no-referrer"
          },
          {
            "key": "Permissions-Policy",
            "value": "geolocation=(), camera=(), microphone=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains; preload"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/service-worker.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/firebase-messaging-sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "**/*.@(js|css|png|jpg|jpeg|gif|webp|svg|ico|mp3|wav|m4a|mp4|webm|ttf|otf|woff|woff2)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/",
        "destination": "/menu.html"
      }
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/menu.html",
        "type": 301
      },
      {
        "source": "/presentations.html",
        "destination": "/index2.html",
        "type": 301
      },
      {
        "source": "/presentations",
        "destination": "/index2.html",
        "type": 301
      },
      {
        "source": "/academy",
        "destination": "/End Of Time Academy.html",
        "type": 301
      }
    ]
  },
  "firestore": {
    "database": "(default)",
    "location": "africa-south1",
    "rules": "firestore-rules.txt",
    "indexes": "firestore.indexes.json"
  }
}
